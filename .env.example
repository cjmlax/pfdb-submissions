# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Where SQLite + uploaded screenshots live (mount a volume here in Docker)
DATA_DIR=/data
# Origin allowed to POST submissions (your website). Use a comma-separated list
# for multiple, or * to allow any (not recommended in production).
ALLOWED_ORIGIN=https://pfdb.cjmlax.com

# ── Admin auth ───────────────────────────────────────────────────────────────
# There is no cookie/session login. Admin access is the signed-in SPA user's
# bearer token (the OIDC id_token from the public "pfdb" Authentik app); the
# worker verifies it and checks the admin group. These are public values (the
# client id is not a secret), and all have working defaults in config.ts.
USER_OIDC_ISSUER=https://authentik.cjmlax.com/application/o/pfdb/
USER_OIDC_CLIENT_ID=gYpSjz6qGj1e1HUPihJeMt9aTP9I0ymgA877eScc
USER_OIDC_GROUPS_CLAIM=pfdb_groups
# Group (within pfdb_groups, "pfdb-" prefix stripped) that grants admin powers —
# e.g. the Authentik group "pfdb-admins" arrives in the token as "admins".
USER_OIDC_ADMIN_GROUP=admins

# Salt for hashing submitter IPs (abuse tracking). Falls back to COOKIE_SECRET if
# unset, so existing deployments keep the same hashes. Generate: `openssl rand -hex 32`
IP_HASH_SECRET=change-me-to-a-long-random-string

# ── Teable (privileged — stays server-side, never shipped to the browser) ────
TEABLE_BASE_URL=https://teable.cjmlax.com
TEABLE_TOKEN=
# Individual table IDs are resolved by name at runtime (and cached), so they no
# longer need to be configured — only the base ID (defaulted in config.ts).
TEABLE_BASE_ID=bseylZk8mJzj9xeoAHy

# ── Changelog / iTunes Poller ────────────────────────────────────────────────
# Absolute path to changelog.json in the web root (SMB build output).
# Leave empty to disable the iTunes poller.
CHANGELOG_PATH=
# Cron schedule for polling the changelog file (default: daily at 6 AM).
CHANGELOG_POLL_CRON=0 6 * * *

# ── Weekly Sets Poller ───────────────────────────────────────────────────────
# Cron schedule for polling https://nimblebit.com/sets/txt (default: Mondays at 2:02 PM ET).
WEEKLY_SETS_POLL_CRON=2 14 * * 1

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880

# ── Notifications ────────────────────────────────────────────────────────────
# Webhook URL(s) to notify on submission events. Comma-separated for multiple.
# Payload is ntfy-compatible JSON (title, message, priority, tags, click) plus
# structured `event` and `submission` fields for generic consumers.
#
# ntfy example:    WEBHOOK_URL=https://ntfy.sh/your-topic
# Discord example: WEBHOOK_URL=https://discord.com/api/webhooks/...
WEBHOOK_URL=
# Base site URL — notifications append /admin/submissions for the "click" link.
ADMIN_URL=https://pfdb.cjmlax.com
# Set any to false to suppress that event type (all default to true).
WEBHOOK_ON_SUBMIT=true
WEBHOOK_ON_APPROVE=true
WEBHOOK_ON_REJECT=true

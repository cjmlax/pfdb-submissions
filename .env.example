# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Where SQLite + uploaded screenshots live (mount a volume here in Docker)
DATA_DIR=/data
# Origin allowed to POST submissions (your website). Use a comma-separated list
# for multiple, or * to allow any (not recommended in production).
ALLOWED_ORIGIN=https://pfdb.cjmlax.com

# ── Auth ────────────────────────────────────────────────────────────────────
# forward  = trust identity headers set by Authentik via Nginx Proxy Manager (recommended)
# oidc     = the worker runs the OIDC code flow itself against Authentik
# password = self-contained password login (emergency fallback only)
AUTH_MODE=forward
# Authentik group required to reach the admin area (the "role")
ADMIN_GROUP=pfdb-admin

# -- forward mode --
# Header names the Authentik outpost forwards (defaults match Authentik)
FORWARD_USER_HEADER=x-authentik-username
FORWARD_GROUPS_HEADER=x-authentik-groups
# Shared secret NPM injects so the worker only trusts requests that came
# through the proxy (prevents header spoofing if the port is ever exposed).
# Generate one: `openssl rand -hex 32`
TRUST_PROXY_SECRET=

# -- password mode --
ADMIN_PASSWORD=

# -- oidc mode --
OIDC_ISSUER=https://auth.cjmlax.com/application/o/pfdb-submissions/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://pfdb-api.cjmlax.com/api/auth/callback
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPE=openid profile email groups

# Signs admin session cookies (password/oidc modes). Generate: `openssl rand -hex 32`
COOKIE_SECRET=change-me-to-a-long-random-string

# ── Teable (privileged — stays server-side, never shipped to the browser) ────
TEABLE_BASE_URL=https://teable.cjmlax.com
TEABLE_TOKEN=
# Target tables for approved combos (defaults match the current pfdb base)
CHROMA_TABLE_ID=tbluqJI6VaHK0fWiPo6
GLASS_TABLE_ID=tblaToM9WCudYNtRjaV

# ── Changelog / iTunes Poller ────────────────────────────────────────────────
# Absolute path to changelog.json in the web root (SMB build output).
# Leave empty to disable the iTunes poller.
CHANGELOG_PATH=
# Cron schedule for polling the changelog file (default: daily at 6 AM).
CHANGELOG_POLL_CRON=0 6 * * *

# ── Weekly Sets Poller ───────────────────────────────────────────────────────
# Cron schedule for polling https://nimblebit.com/sets/txt (default: Mondays at 2:02 PM ET).
WEEKLY_SETS_POLL_CRON=2 14 * * 1

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880

# ── Notifications ────────────────────────────────────────────────────────────
# Webhook URL(s) to notify on submission events. Comma-separated for multiple.
# Payload is ntfy-compatible JSON (title, message, priority, tags, click) plus
# structured `event` and `submission` fields for generic consumers.
#
# ntfy example:    WEBHOOK_URL=https://ntfy.sh/your-topic
# Discord example: WEBHOOK_URL=https://discord.com/api/webhooks/...
WEBHOOK_URL=
# Public URL of the admin panel — used as the "click" link in notifications.
ADMIN_URL=https://pfdb-api.cjmlax.com
# Set any to false to suppress that event type (all default to true).
WEBHOOK_ON_SUBMIT=true
WEBHOOK_ON_APPROVE=true
WEBHOOK_ON_REJECT=true
